  const [sel,setSel]=useState(null);
  const [lines,setLines]=useState([{desc:"",qty:1,price:0,vat:0.15}]);
  const [f,setF]=useState({cust_id:"",date:today(),due:"",currency:"SAR",proj_id:""});

  const sub=lines.reduce((s,l)=>s+l.qty*l.price,0);
  const vatAmt=lines.reduce((s,l)=>s+l.qty*l.price*l.vat,0);

  const confirm=id=>{
    const inv=data.invoices.find(i=>i.id===id);
    const je={id:`je_${Date.now()}`,ref:`JE-AUTO-${inv.number}`,date:inv.date,desc:`ترحيل تلقائي — ${inv.number}`,status:"posted",source:"Sales",debit:inv.total,credit:inv.total,
      lines:[{acc:"1200",dr:inv.total,cr:0,desc:`ذمم مدينة — ${data.customers.find(c=>c.id===inv.cust_id)?.name_ar}`},{acc:"4100",dr:0,cr:inv.sub,desc:"إيراد خدمات"},{acc:"2310",dr:0,cr:inv.vat,desc:"VAT مخرجات 15%"}]};
    setData(d=>({...d,invoices:d.invoices.map(i=>i.id===id?{...i,status:"posted",zatca:"pending"}:i),journals:[je,...d.journals]}));
  };
  const retryZ=id=>setData(d=>({...d,invoices:d.invoices.map(i=>i.id===id?{...i,zatca:"cleared"}:i)}));

  const create=()=>{
    if(!f.cust_id) return;
    const num=`INV-2025-${String(840+data.invoices.length+1).padStart(4,"0")}`;
    const inv={id:`inv_${Date.now()}`,number:num,cust_id:f.cust_id,date:f.date,due:f.due||f.date,sub,vat:vatAmt,total:sub+vatAmt,status:"draft",zatca:null,currency:f.currency,proj_id:f.proj_id,lines};
    setData(d=>({...d,invoices:[inv,...d.invoices]}));
    setModal(false);setLines([{desc:"",qty:1,price:0,vat:0.15}]);setF({cust_id:"",date:today(),due:"",currency:"SAR",proj_id:""});
  };

  const totalPosted=data.invoices.filter(i=>i.status==="posted").reduce((s,i)=>s+i.sub,0);
  const totalVAT=data.invoices.filter(i=>i.status==="posted").reduce((s,i)=>s+i.vat,0);

