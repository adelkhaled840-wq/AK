const fmtN = n => new Intl.NumberFormat("en-SA").format(Math.round(Number(n)||0));
const today = () => new Date().toISOString().split("T")[0];
const gGross = e => (e.basic||0)+(e.housing||0)+(e.transport||0)+(e.mobile||0)+(e.medical||0);
const gGOSI_emp = e => e.nationality==="Saudi" ? e.basic*0.09 : e.basic*0.02;
const gGOSI_co  = e => e.nationality==="Saudi" ? e.basic*0.09 : 0;
const gNet  = e => gGross(e) - gGOSI_emp(e);
const gEOS  = e => {
  const yrs = (Date.now()-new Date(e.hire_date))/(365.25*86400000);
  if(yrs<2) return 0;
  if(yrs<5) return (e.basic/2)*Math.floor(yrs);
  return e.basic*Math.floor(yrs);
};

