// ═══════════════════════ HR ═══════════════════════
const HR = ({data,setData}) => {
  const [tab,setTab]=useState("employees");
  const [selEmp,setSelEmp]=useState(null);
  const [modal,setModal]=useState(false);

  const saudis=data.employees.filter(e=>e.nationality==="Saudi").length;
  const saudPct=Math.round(saudis/data.employees.length*100);
  const totalGross=data.employees.reduce((s,e)=>s+gGross(e),0);
  const totalGOSI=data.employees.reduce((s,e)=>s+gGOSI_emp(e)+gGOSI_co(e),0);

  const runPayroll=()=>{
    const gross=data.employees.reduce((s,e)=>s+gGross(e),0);
    const ge=data.employees.reduce((s,e)=>s+gGOSI_emp(e),0);
    const gc=data.employees.reduce((s,e)=>s+gGOSI_co(e),0);
    const net=gross-ge;
    const run={id:`pay_${Date.now()}`,period:"أبريل 2025",month:4,year:2025,status:"draft",gross,gosi_emp:ge,gosi_co:gc,net,headcount:data.employees.length};
    const ap={id:`ap_${Date.now()}`,type:"payroll",ref:"PAYROLL-APR-2025",amount:net,requester:"سارة الرشيدي",status:"pending",level:"المدير المالي CFO",date:today(),detail:`مسير رواتب أبريل 2025 — ${data.employees.length} موظف`};
    setData(d=>({...d,payroll_runs:[run,...d.payroll_runs],approvals:[ap,...d.approvals]}));
    setModal(false);
