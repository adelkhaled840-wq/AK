          <KPI label="GOSI / شهر" value={`SAR ${fmtN(totalGOSI)}`} icon="ti-heart-handshake"/>
          <KPI label="مخصص نهاية الخدمة" value={`SAR ${fmtN(data.employees.reduce((s,e)=>s+gEOS(e),0))}`} icon="ti-scale"/>
        </div>
      </div>
      <div style={{padding:"0 16px"}}>
        <TabBar tabs={[["employees","الموظفون"],["payroll","مسيرات الرواتب"],["gosi","GOSI"]]}
          active={tab} onChange={setTab}
          actions={tab==="payroll"?<button style={{fontSize:12}} onClick={()=>setModal(true)}>+ تشغيل مسير جديد</button>:null}/>
