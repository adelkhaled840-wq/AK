                </div>
                <div style={{display:"flex",gap:5,flexDirection:"column",alignItems:"flex-end"}}>
                  <Bdg c={isOver?"red":isRisk?"amber":"green"}>{isOver?"تجاوز الميزانية":isRisk?"تحت المراقبة":"على المسار"}</Bdg>
                  <Bdg c="blue" sm>{p.pct}% مكتمل</Bdg>
                </div>
              </div>
              <div style={{display:"grid",gridTemplateColumns:"1fr 1fr 1fr 1fr",gap:8,marginBottom:10}}>
                {[["الميزانية",fmtN(p.budget)],["الفعلي",fmtN(p.actual)],["المُفوتَر",fmtN(p.invoiced)],["الهامش",`${margin>0?"+":""}${margin}%`]].map(([l,v])=>(
                  <div key={l}><div style={{fontSize:10,color:"var(--color-text-tertiary)",marginBottom:2}}>{l}</div>
                  <div style={{fontFamily:"monospace",fontSize:12,fontWeight:500,color:l==="الهامش"&&margin<0?"var(--color-text-danger)":l==="الهامش"?"var(--color-text-success)":"var(--color-text-primary)"}}>{v}</div></div>
