          {key:"status",label:"الحالة",fn:r=><Bdg c={r.status==="approved"?"green":"amber"} sm>{r.status==="approved"?"معتمد":"ينتظر"}</Bdg>},
        ]}/>
      </Card>
      {modal&&(
        <Modal title="إضافة بطاقة وقت" onClose={()=>setModal(false)}>
          <G2>
            <Fld label="الموظف *"><select value={f.emp_id} onChange={e=>setF(x=>({...x,emp_id:e.target.value}))} style={{width:"100%"}}>
              <option value="">اختر...</option>{data.employees.map(e=><option key={e.id} value={e.id}>{e.name_ar}</option>)}
