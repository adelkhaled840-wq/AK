          <KPI label="إجمالي VAT محصَّل" value={`${fmtN(totalVAT/1000000)}M SAR`} icon="ti-receipt-tax" color="#BA7517"/>
          <KPI label="ZATCA معلقة" value={`${data.invoices.filter(i=>i.zatca==="pending").length}`} delta="إرسال فوري مطلوب" icon="ti-shield-check" color="#D85A30"/>
          <KPI label="فواتير مسودة" value={`${data.invoices.filter(i=>i.status==="draft").length}`} delta="لم تُرحَّل بعد" icon="ti-file-description" color="#534AB7"/>
        </div>
      </div>
      <div style={{padding:"0 16px"}}>
        <TabBar tabs={[["invoices","الفواتير"],["customers","العملاء"],["aging","الاستحقاقات"]]}
          active={tab} onChange={setTab}
          actions={<button style={{fontSize:12}} onClick={()=>setModal(true)}>+ فاتورة جديدة</button>}/>
      </div>
      <div style={{flex:1,overflowY:"auto",padding:16}}>
        {tab==="invoices"&&(
