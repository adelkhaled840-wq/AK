// ═══════════════════════ APPROVALS ═══════════════════════
const Approvals = ({data,setData}) => {
  const approve=id=>setData(d=>({...d,approvals:d.approvals.map(a=>a.id===id?{...a,status:"approved"}:a)}));
  const reject=id=>setData(d=>({...d,approvals:d.approvals.map(a=>a.id===id?{...a,status:"rejected"}:a)}));

  const TYPE_MAP={
    purchase_order:["أمر شراء","amber"],
    payment:["دفعة مالية","red"],
    payroll:["مسير رواتب","purple"],
    expense:["مصروف","blue"],
    credit_note:["إشعار دائن","coral"],
  };

  const ApCard=({ap})=>{
    const [lbl,col]=TYPE_MAP[ap.type]||["طلب","gray"];
    return(
      <div style={{background:"var(--color-background-primary)",border:`0.5px solid ${ap.status==="pending"?"var(--color-border-warning)":ap.status==="approved"?"var(--color-border-success)":"var(--color-border-danger)"}`,borderRadius:"var(--border-radius-lg)",padding:14,marginBottom:10}}>
        <div style={{display:"flex",alignItems:"flex-start",gap:12}}>
          <div style={{flex:1}}>
            <div style={{display:"flex",gap:6,alignItems:"center",marginBottom:6,flexWrap:"wrap"}}>
              <Bdg c={col}>{lbl}</Bdg>
              <span style={{fontFamily:"monospace",fontSize:12,color:"var(--color-text-secondary)"}}>{ap.ref}</span>
              <span style={{fontSize:11,color:"var(--color-text-tertiary)"}}>· {ap.date}</span>
            </div>
            <div style={{fontSize:13,color:"var(--color-text-secondary)",marginBottom:8}}>{ap.detail}</div>
            <div style={{display:"grid",gridTemplateColumns:"auto auto auto",gap:16,fontSize:12}}>
              <div>
                <div style={{fontSize:10,color:"var(--color-text-tertiary)"}}>المبلغ</div>
                <div style={{fontFamily:"monospace",fontWeight:500,fontSize:14}}>SAR {fmtN(ap.amount)}</div>
              </div>
              <div>
                <div style={{fontSize:10,color:"var(--color-text-tertiary)"}}>مُقدَّم من</div>
                <div style={{fontSize:13}}>{ap.requester}</div>
              </div>
              <div>
                <div style={{fontSize:10,color:"var(--color-text-tertiary)"}}>مستوى الموافقة</div>
                <div style={{fontSize:12}}>{ap.level}</div>
              </div>
            </div>
          </div>
          <div style={{flexShrink:0}}>
            {ap.status==="pending"?(
              <div style={{display:"flex",gap:6,flexDirection:"column"}}>
                <button onClick={()=>approve(ap.id)} style={{fontSize:12,background:"var(--color-background-success)",color:"var(--color-text-success)",borderColor:"var(--color-border-success)",padding:"5px 12px"}}>اعتماد ✓</button>
                <button onClick={()=>reject(ap.id)} style={{fontSize:12,color:"var(--color-text-danger)",borderColor:"var(--color-border-danger)",padding:"5px 12px"}}>رفض ✗</button>
              </div>
            ):(
              <Bdg c={ap.status==="approved"?"green":"red"}>{ap.status==="approved"?"معتمد ✓":"مرفوض ✗"}</Bdg>
            )}
          </div>
        </div>
      </div>
    );
  };

  const pending=data.approvals.filter(a=>a.status==="pending");
  const done=data.approvals.filter(a=>a.status!=="pending");

  return(
    <PRow>
      <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:10}}>
        <KPI label="طلبات معلقة" value={pending.length} delta="تحتاج قراراً" icon="ti-clock" color="#BA7517"/>
        <KPI label="إجمالي المبالغ المعلقة" value={`SAR ${fmtN(pending.reduce((s,a)=>s+a.amount,0))}`} icon="ti-coin"/>
        <KPI label="معتمدة" value={data.approvals.filter(a=>a.status==="approved").length} up icon="ti-circle-check" color="#1D9E75"/>
        <KPI label="مرفوضة" value={data.approvals.filter(a=>a.status==="rejected").length} icon="ti-circle-x" color="#E24B4A"/>
      </div>
      {pending.length>0&&(
        <div>
          <div style={{fontSize:12,fontWeight:500,color:"var(--color-text-warning)",marginBottom:8}}>⏳ تنتظر اتخاذ قرار ({pending.length})</div>
          {pending.map(ap=><ApCard key={ap.id} ap={ap}/>)}
        </div>
      )}
      {done.length>0&&(
        <div>
          <div style={{fontSize:12,fontWeight:500,color:"var(--color-text-tertiary)",marginBottom:8}}>المُعالَجة ({done.length})</div>
          {done.map(ap=><ApCard key={ap.id} ap={ap}/>)}
        </div>
      )}
    </PRow>
  );
};

