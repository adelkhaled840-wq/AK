              {key:"number",label:"رقم الفاتورة",mono:true},
              {key:"cust_id",label:"العميل",fn:r=>data.customers.find(c=>c.id===r.cust_id)?.name_ar||"-"},
              {key:"date",label:"التاريخ"},{key:"due",label:"الاستحقاق"},
              {key:"sub",label:"قبل VAT",r:true,mono:true,fn:r=>fmtN(r.sub)},
              {key:"vat",label:"VAT 15%",r:true,mono:true,fn:r=><span style={{color:"var(--color-text-warning)"}}>{fmtN(r.vat)}</span>},
              {key:"total",label:"الإجمالي",r:true,mono:true,fn:r=><strong>{fmtN(r.total)}</strong>},
