  const [col, setCol]       = useState(false);
  const [showN, setShowN]   = useState(false);
  const [data, setData]     = useState({ ...INIT });

  const unread = data.notifications.filter(n => !n.read).length;
  const [title, sub] = META[page] || ["ERP", ""];

  const renderPage = () => {
    const p = { data, setData };
    switch (page) {
      case "dashboard":  return <Dashboard  {...p} />;
      case "accounting": return <Accounting {...p} />;
      case "sales":      return <Sales      {...p} />;
      case "purchase":   return <Purchase   {...p} />;
      case "projects":   return <Projects   {...p} />;
      case "hr":         return <HR         {...p} />;
      case "tax":        return <Tax        {...p} />;
      case "banking":    return <Banking    {...p} />;
      case "approvals":  return <Approvals  {...p} />;
      case "reports":    return <Reports    {...p} />;
      case "audit":      return <AuditLog   {...p} />;
      case "settings":   return <Settings   {...p} />;
      default:           return <Dashboard  {...p} />;
    }
  };

  return (
    <div
      onClick={() => showN && setShowN(false)}
      style={{ display:"flex", height:"100vh", background:"var(--color-background-tertiary)", fontFamily:"var(--font-sans)", overflow:"hidden", position:"relative" }}
    >
      <Sidebar active={page} onNav={p => { setPage(p); setShowN(false); }} col={col} />

      <div style={{ flex:1, display:"flex", flexDirection:"column", overflow:"hidden", minWidth:0 }}>
        <Topbar
          title={title} sub={sub}
          onToggle={() => setCol(c => !c)}
          nCount={unread}
          onNotif={e => { e.stopPropagation(); setShowN(s => !s); }}
        />
        <div style={{ flex:1, overflowY:"auto" }}>
          {renderPage()}
        </div>
      </div>

      {showN && (
        <div onClick={e => e.stopPropagation()}>
          <NotifPanel data={data} setData={setData} onClose={() => setShowN(false)} />
        </div>
      )}
    </div>
  );
}
